{
  "expo": {
    "name": "Mi Tarjeta Digital",
    "slug": "business-card-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mitarjetadigital.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3f67c4"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.mitarjetadigital.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        { "photosPermission": "Necesitamos acceso a tus fotos para actualizar tu perfil." }
      ]
    ],
    "scheme": "mitarjeta"
  }
}
